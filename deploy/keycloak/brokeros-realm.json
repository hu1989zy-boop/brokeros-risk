{
  "realm": "brokeros",
  "enabled": true,
  "displayName": "BrokerOS Risk (local development only)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "clients": [
    {
      "clientId": "brokeros-risk",
      "name": "BrokerOS Risk API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "brokeros-risk-console",
      "name": "BrokerOS Risk Console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:4173/*"
      ],
      "webOrigins": [
        "http://localhost:4173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "brokeros-risk-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "brokeros-risk",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "16000000-0000-4000-8000-000000000001",
      "username": "q016-operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Q016",
      "lastName": "Operator"
    }
  ]
}
